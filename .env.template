# ==============================================================================
# Local RAG System - Environment Configuration Template
# Copy this file to .env and populate with your credentials
# ==============================================================================

# --- GitHub Authentication ---
# Personal Access Token (classic or fine-grained) with 'repo' scope
GITHUB_PAT=

# --- Azure DevOps Authentication ---
# Personal Access Token with 'Code (Read)' and 'Work Items (Read)' scopes
ADO_PAT=
ADO_ORGANIZATION=
ADO_PROJECT=

# --- Atlassian Confluence Authentication ---
# Base URL (e.g. https://your-domain.atlassian.net/wiki)
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
# API token generated from https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# --- Local Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
# Keep alive duration (unload idle models promptly to conserve 16GB RAM)
OLLAMA_KEEP_ALIVE=5m

# --- Model Selection & RAM Modes ---
# Default LLM: llama3.1:8b or qwen2.5-coder:7b
DEFAULT_LLM_MODEL=llama3.1:8b
# Fallback LLM for low-RAM mode: llama3.2:3b or qwen2.5-coder:3b
FALLBACK_LLM_MODEL=llama3.2:3b
# Toggle low RAM mode (True forces fallback 3B model)
LOW_RAM_MODE=false
# Embedding model (768-dim)
EMBED_MODEL=nomic-embed-text

# --- Reranker Configuration ---
# Options: flashrank (default, CPU ONNX, <100MB RAM), ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=flashrank

# --- Storage Configuration ---
DUCKDB_PATH=./data/duckdb/store.duckdb
REPOS_CACHE_DIR=./data/repos
MAX_DUCKDB_MEMORY=2GB
